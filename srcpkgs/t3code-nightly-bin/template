# Template file for 't3code-nightly-bin'
pkgname=t3code-nightly-bin
version=0.1.3.nightly.20261024.3630
revision=1
archs="x86_64 aarch64"
hostmakedepends="bsdtar"
depends="alsa-lib at-spi2-core gtk+3 libgbm libnotify libsecret libXScrnSaver
 libXtst nss util-linux-libs xdg-utils hicolor-icon-theme"
short_desc="Desktop control surface for coding agents (nightly)"
maintainer="Wizzard <rich@bandaholics.cash>"
license="MIT"
homepage="https://t3.codes"
changelog="https://github.com/pingdotgg/t3code/releases"
conflicts="t3code>=0 t3code-bin>=0"
nostrip=yes
nopie=yes
noshlibprovides=yes
amd64_checksum=02ccc271f7ed7e4da296d8aead5d8a035324a24098d85f6e2fa19e3b2d18d3a8
arm64_checksum=eff47b16f95b0037c3eb768bfb6a1cfe2bccb87d2edd2b6795d2b3af83052818

case "$XBPS_TARGET_MACHINE" in
x86_64) _deb_arch=amd64; _deb_checksum=$amd64_checksum; _other_arch=arm64 ;;
aarch64) _deb_arch=arm64; _deb_checksum=$arm64_checksum; _other_arch=x64 ;;
esac
_upstream_version="${version/.nightly./-nightly.}"
distfiles="https://github.com/pingdotgg/t3code/releases/download/v${_upstream_version}/T3-Code-${_upstream_version}-${_deb_arch}.deb
 https://raw.githubusercontent.com/pingdotgg/t3code/v${_upstream_version}/LICENSE>T3-Code-LICENSE.txt"
checksum="${_deb_checksum}
 935d8f2af0c703f9c39517ee57cc4930b19d02d533be930b63f0e82f93614b43"
skip_extraction="T3-Code-LICENSE.txt"

do_install() {
	vcopy opt /opt
	# XBPS owns updates; the upstream feed would try to install Debian packages.
	rm "$DESTDIR/opt/T3 Code (Nightly)/resources/app-update.yml"
	local modules="$DESTDIR/opt/T3 Code (Nightly)/resources/app.asar.unpacked/node_modules"
	# Upstream ships unused musl and foreign node-pty prebuilds in glibc packages.
	find "$modules" -type d -name '*-musl' -prune -exec rm -rf {} +
	rm -rf "$modules/node-pty/prebuilds/linux-$_other_arch"
	vcopy usr/share/icons /usr/share
	vinstall usr/share/applications/t3code.desktop 644 usr/share/applications t3code-nightly.desktop
	vsed -i 's|^Exec=.*|Exec=t3code-nightly %U|' "$DESTDIR/usr/share/applications/t3code-nightly.desktop"
	vmkdir usr/bin
	ln -s '/opt/T3 Code (Nightly)/t3code' "$DESTDIR/usr/bin/t3code-nightly"
	ln -s t3code-nightly "$DESTDIR/usr/bin/t3code"
	chmod 4755 "$DESTDIR/opt/T3 Code (Nightly)/chrome-sandbox"
	vlicense "$XBPS_SRCDISTDIR/$pkgname-$version/T3-Code-LICENSE.txt" LICENSE
	vlicense 'opt/T3 Code (Nightly)/LICENSE.electron.txt'
	vlicense 'opt/T3 Code (Nightly)/LICENSES.chromium.html'
}
