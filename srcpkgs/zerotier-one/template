# Template file for 'zerotier-one'
pkgname=zerotier-one
version=1.16.2
revision=1
archs="x86_64 aarch64 x86_64-musl aarch64-musl"
build_style=gnu-makefile
make_build_args="ZT_SSO_SUPPORTED=0"
make_build_target="one"
short_desc="Smart programmable Ethernet switch for planet Earth"
maintainer="Wizzard <rich@bandaholics.cash>"
license="MPL-2.0"
homepage="https://www.zerotier.com/"
changelog="https://raw.githubusercontent.com/zerotier/ZeroTierOne/master/RELEASE-NOTES.md"
distfiles="https://github.com/zerotier/ZeroTierOne/archive/refs/tags/${version}.tar.gz"
checksum=2c607f573c6e38815433af289d364a689a203b18b51125f06c4472014d0657f0

do_install() {
	vbin zerotier-one
	ln -s zerotier-one "${DESTDIR}/usr/bin/zerotier-cli"
	ln -s zerotier-one "${DESTDIR}/usr/bin/zerotier-idtool"
	vman doc/zerotier-one.8
	vman doc/zerotier-cli.1
	vman doc/zerotier-idtool.1
	vmkdir var/lib/zerotier-one
}

post_install() {
	vlicense LICENSE.txt
	vsv zerotier-one
}
