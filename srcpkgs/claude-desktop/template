# Template file for 'claude-desktop'
pkgname=claude-desktop
version=1.26832.0
revision=3
archs="x86_64"
depends="desktop-file-utils hicolor-icon-theme libnotify libsecret xdg-desktop-portal xdg-utils"
short_desc="Claude AI Desktop Application"
maintainer="rich@bandaholics.cash"
license="custom:Claude"
homepage="https://claude.ai"
changelog="https://github.com/patrickjaja/claude-desktop-bin/releases"
repository="nonfree"
restricted=yes
nostrip=yes
_tag=v1.26832.0-2
distfiles="https://github.com/patrickjaja/claude-desktop-bin/releases/download/${_tag}/claude-desktop-${version}-linux.tar.gz"
checksum=6813395c973924c381417cbd60abdfffc2543b653dbe7497b0155a1768433bb6

do_install() {
	# The tarball ships a self-contained Electron tree; /usr/lib/claude-desktop
	# is the path the bundled launcher probes for the "claude" binary.
	vmkdir usr/lib/${pkgname}
	vcopy "claude-desktop/*" usr/lib/${pkgname}
	chmod 4755 ${DESTDIR}/usr/lib/${pkgname}/chrome-sandbox

	vbin launcher/claude-desktop

	vinstall ${FILESDIR}/com.anthropic.Claude.desktop 0644 usr/share/applications
	vinstall icons/claude-desktop.png 0644 usr/share/icons/hicolor/256x256/apps

	vlicense copyright LICENSE
}
