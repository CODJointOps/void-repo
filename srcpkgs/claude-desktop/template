# Template file for 'claude-desktop'
pkgname=claude-desktop
version=1.40609.1
revision=1
archs="x86_64 aarch64"
hostmakedepends="tar xz"
depends="desktop-file-utils hicolor-icon-theme xdg-desktop-portal xdg-utils"
short_desc="Claude AI Desktop Application"
maintainer="Wizzard <rich@bandaholics.cash>"
license="custom:Claude"
homepage="https://claude.ai"
changelog="https://code.claude.com/docs/en/desktop-linux"
repository="nonfree"
restricted=yes
nostrip=yes
noshlibprovides=yes
lib32disabled=yes

# First-party Debian package from Anthropic's own signed apt repository. The
# checksums below are the ones published in that repo's Release-signed
# Packages index (key 31DD DE24 DDFA B679 F42D 7BD2 BAA9 29FF 1A7E CACE), so
# pinning them here carries Anthropic's signature through to the build.
_repo=https://downloads.claude.ai/claude-desktop/apt/stable

case "${XBPS_TARGET_MACHINE}" in
x86_64)
	_deb_arch=amd64
	checksum=80182e8511c6bbee6de26c7ee225fbd2a9aba2274ef1405a1d89cd8fe7a380dc
	;;
aarch64)
	_deb_arch=arm64
	checksum=493ccc06030c5dbb225add135823385d8cfb400a5922704de377ea8f55b39c40
	;;
*)
	broken="No distfiles available for this target"
	;;
esac

_debfile="${pkgname}_${version}_${_deb_arch}.deb"
distfiles="${_repo}/pool/main/c/${pkgname}/${_debfile}"

do_extract() {
	ar x "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_debfile}"
	# Upstream has shipped data.tar.xz so far; do not hardcode the compressor.
	tar xf $(ls data.tar.*) -C "${wrksrc}"
}

do_install() {
	vmkdir usr/lib
	vcopy usr/lib/${pkgname} usr/lib
	# Chromium's setuid sandbox fallback; upstream ships it 4755 and vcopy
	# drops the bit.
	chmod 4755 ${DESTDIR}/usr/lib/${pkgname}/chrome-sandbox

	vmkdir usr/bin
	ln -s ../lib/${pkgname}/${pkgname} ${DESTDIR}/usr/bin/${pkgname}

	vinstall usr/share/applications/com.anthropic.Claude.desktop 0644 \
		usr/share/applications
	for _icon in usr/share/icons/hicolor/*/apps/${pkgname}.png; do
		_size=${_icon#usr/share/icons/hicolor/}
		_size=${_size%%/*}
		vinstall "${_icon}" 0644 "usr/share/icons/hicolor/${_size}/apps"
	done

	# The .deb registers these from postinst; both reference absolute paths
	# that are correct at build time, so install them directly.
	local _sp=usr/lib/${pkgname}/resources/gnome-search-provider
	vinstall ${_sp}/com.anthropic.Claude.search-provider.ini 0644 \
		usr/share/gnome-shell/search-providers
	vinstall ${_sp}/com.anthropic.Claude.SearchProvider.service 0644 \
		usr/share/dbus-1/services

	vlicense usr/share/doc/${pkgname}/copyright LICENSE
}
