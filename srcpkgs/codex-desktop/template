# Template file for 'codex-desktop'
pkgname=codex-desktop
version=26.901.41600
revision=1
archs="x86_64 aarch64"
hostmakedepends="ImageMagick tar xz"
depends="alsa-lib at-spi2-atk at-spi2-core cairo dbus-libs desktop-file-utils
 eudev-libudev expat gdk-pixbuf glib gtk+3 hicolor-icon-theme libcups libgbm
 libnotify libusb libX11 libXcomposite libXdamage libXext libXfixes libXrandr
 libxcb libxkbcommon nspr nss pango xdg-desktop-portal xdg-utils"
short_desc="ChatGPT desktop app with Codex by OpenAI"
maintainer="Wizzard <rich@bandaholics.cash>"
license="custom:OpenAI-Terms"
homepage="https://developers.openai.com/codex/app"
changelog="https://learn.chatgpt.com/docs/linux/linux-app"
repository="nonfree"
restricted=yes
nostrip=yes
noshlibprovides=yes
noverifyrdeps=yes
lib32disabled=yes

case "${XBPS_TARGET_MACHINE}" in
x86_64)
	_deb_arch=amd64
	_prebuild_keep="x64"
	checksum=15cf422a77e8f28a7553d3180b8c72784a994438a141784c82d72cde93efca77
	;;
aarch64)
	_deb_arch=arm64
	_prebuild_keep="arm64"
	checksum=8d5141b299ca593255fa25760895e84375937cc305197528c822dfa71ac2a3bf
	;;
*)
	broken="No distfiles available for this target"
	;;
esac

_debfile="chatgpt_${version}_${_deb_arch}.deb"
distfiles="https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/${_debfile}"

do_extract() {
	ar x "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_debfile}"
	# Upstream has shipped data.tar.xz so far; do not hardcode the compressor.
	tar xf $(ls data.tar.*) -C "${wrksrc}"
}

do_install() {
	# Vendored node prebuilds ship every OS/libc variant; the foreign ELFs make
	# the shlib scan resolve against musl and arm loaders that are not installed.
	find usr/lib/chatgpt -type d -name prebuilds -prune | while read -r _dir; do
		find "${_dir}" -mindepth 1 -maxdepth 1 -type d \
			! -name "*linux-${_prebuild_keep}" -exec rm -rf {} +
	done

	vmkdir usr/lib
	vcopy usr/lib/chatgpt usr/lib

	vbin "${FILESDIR}/chatgpt-launcher.sh" chatgpt

	# Upstream entry has no Keywords, so "codex" does not match it in a
	# launcher, and no StartupWMClass, so the window is not tied to the icon.
	vinstall "${FILESDIR}/chatgpt.desktop" 0644 usr/share/applications

	# Upstream ships one 1024px pixmap; menus and launchers look in hicolor.
	vinstall usr/share/pixmaps/chatgpt.png 0644 usr/share/pixmaps
	for _size in 16 24 32 48 64 128 256 512; do
		magick usr/share/pixmaps/chatgpt.png -resize ${_size}x${_size} \
			"chatgpt-${_size}.png"
		vinstall "chatgpt-${_size}.png" 0644 \
			"usr/share/icons/hicolor/${_size}x${_size}/apps" chatgpt.png
	done
	vinstall usr/share/pixmaps/chatgpt.png 0644 \
		usr/share/icons/hicolor/1024x1024/apps chatgpt.png

	vlicense usr/share/doc/chatgpt/copyright LICENSE.electron
}
